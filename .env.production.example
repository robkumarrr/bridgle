# ──────────────────────────────────────────────────────────────────────────────
# Bridgle — Production Environment Template
# ──────────────────────────────────────────────────────────────────────────────
# Copy this to .env.production on the server and fill in real values.
# NEVER commit .env.production — it contains secrets.
#
# This file is used two ways:
#   1. env_file: .env.production  → injects vars into the app container
#   2. docker compose --env-file .env.production  → compose interpolates ${VAR}
#      in docker-compose.prod.yml (used for postgres POSTGRES_* vars)
# ──────────────────────────────────────────────────────────────────────────────

# ── Application ───────────────────────────────────────────────────────────────

APP_NAME=Bridgle
APP_ENV=production
APP_DEBUG=false

# Generate with: docker compose -f docker-compose.prod.yml exec bridgle-app php artisan key:generate --show
# Then paste the output here (base64:...)
APP_KEY=

# Your domain or droplet IP — no trailing slash
APP_URL=https://yourdomain.com

# ── Database ──────────────────────────────────────────────────────────────────
# DB_HOST must match the service name in docker-compose.prod.yml (bridgle-db),
# because Docker's internal DNS resolves service names to container IPs.

DB_CONNECTION=pgsql
DB_HOST=bridgle-db
DB_PORT=5432
DB_DATABASE=bridgle_db
DB_USERNAME=bridgle
DB_PASSWORD=change-me-to-something-strong

# ── Cache / Session / Queue ───────────────────────────────────────────────────
# 'file' is the simplest option and works fine for a single-server deployment.
# If you ever scale horizontally, switch these to 'redis'.

CACHE_STORE=file
SESSION_DRIVER=file
QUEUE_CONNECTION=sync

# ── Logging ───────────────────────────────────────────────────────────────────
# 'stack' writes to storage/logs/laravel.log (persisted via Docker volume).
# 'error' level means only errors and above are logged — keeps logs quiet in prod.

LOG_CHANNEL=stack
LOG_LEVEL=error

# ── Mail (optional — only needed if you add email features) ───────────────────
# MAIL_MAILER=smtp
# MAIL_HOST=
# MAIL_PORT=587
# MAIL_USERNAME=
# MAIL_PASSWORD=
# MAIL_FROM_ADDRESS=noreply@yourdomain.com
# MAIL_FROM_NAME="${APP_NAME}"
